+        </actionGroup>
+
+        <!-- macOS: latest version could not be determined (e.g. no network) ->
+             skip pgAdmin rather than prompt/act on an unknown version -->
+        <actionGroup>
+            <actionList>
+                <setInstallerVariable name="install_pgadmin" value="0"/>
+                <logMessage>
+                    <text>WARNING: could not determine the latest pgAdmin 4 version from the FTP listing. Skipping pgAdmin 4 installation - install it manually from https://www.pgadmin.org</text>
+                </logMessage>
+                <showWarning text="Could not reach the pgAdmin 4 download server. pgAdmin 4 was not installed - please install it manually from https://www.pgadmin.org">
+                    <ruleList>
+                        <compareText text="${installer_ui}" logic="does_not_equal" value="unattended"/>
