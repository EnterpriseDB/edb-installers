+
+        <!-- macOS: pgAdmin NOT installed -> ask whether to install the latest -->
+        <actionGroup>
+            <actionList>
+                <showQuestion>
+                    <text>pgAdmin is the recommended graphical management tool for PostgreSQL. Would you like to automatically download and install the latest version ${latest_pgadmin_version} of pgAdmin 4?</text>
+                    <variable>install_pgadmin_answer</variable>
+                    <default>Yes</default>
