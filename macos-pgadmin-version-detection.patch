@@ -2091,11 +2091,93 @@ ${dbsummary}${cltsummary}${sbsummary}${msg(summary.installation.logfile)}: ${Ins
             </ruleList>
         </actionGroup>
 
-        <!-- macOS: ask whether to install pgAdmin 4; the popup only records the choice -->
+        <!-- macOS: detect installed pgAdmin (from the app's Info.plist) and the
